---
import { getCollection } from 'astro:content';
import Artikel from '../../layouts/Artikel.astro';
export async function getStaticPaths() {
  return (await getCollection('geschichten')).map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
---
<Artikel entry={entry} sammlung="geschichten" basisPfad="/geschichten" elternName="Geschichten" markdownUrl={`/geschichten/${entry.id}.md`} />
