---
import { PROJEKTE, KATEGORIEN } from '../lib/site';
interface Eintrag {
  url: string;
  title: string;
  autoren?: string[];
  kategorie?: string;
  broschuere?: number;
  zeitraum?: string;
  projekte?: string[];
  zusammenfassung?: string;
  datum?: string;
}
interface Props { eintraege: Eintrag[]; zeigeKategorie?: boolean; morph?: boolean }
const { eintraege, zeigeKategorie = true, morph = false } = Astro.props;
/** Beim Seitenwechsel wandert der Titel aus der Liste in die Artikelüberschrift. */
const morphName = (u: string) => 'a-' + u.replace(/[^a-zA-Z0-9]+/g, '-').replace(/^-+|-+$/g, '');
---
<ul class="liste">
  {eintraege.map((e) => (
    <li>
      <div class="titel"><a href={e.url} transition:name={morph ? morphName(e.url) : undefined}>{e.title}</a></div>
      <div class="neben">
        {e.autoren?.length ? <span>{e.autoren.join(', ')}</span> : null}
        {zeigeKategorie && e.kategorie && KATEGORIEN[e.kategorie] ? <span>{KATEGORIEN[e.kategorie].name}</span> : null}
        {e.broschuere ? <span>Broschüre Teil {e.broschuere}</span> : null}
        {e.datum ? <span>{e.datum}</span> : null}
        {e.zeitraum ? <span>{e.zeitraum}</span> : null}
        {e.projekte?.map((p) => PROJEKTE[p] ? <span class={`stempel ${PROJEKTE[p].css}`}>{PROJEKTE[p].name}</span> : null)}
      </div>
      {e.zusammenfassung ? <p class="kurz">{e.zusammenfassung}</p> : null}
    </li>
  ))}
</ul>
